# MongoDB connection string (Atlas or self-hosted)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/flexiseo-expert"

# OpenAI API key — runs one AI pass automatically after each audit (executive summary, action plan, issue tips).
# Optional: audits run fully without it using rule-based findings.
OPENAI_API_KEY=""

# OpenAI cost controls (defaults are conservative):
# OPENAI_AUTO_GENERATE="false"   # opt out of the single post-audit AI pass
# OPENAI_MAX_ISSUES="8"          # max critical/warning issues sent to AI (max 20)
# OPENAI_MAX_PAGES="0"           # per-page AI summaries — 0 disables (recommended)
# OPENAI_ISSUE_BATCH_SIZE="8"    # issues per batched API call
# OPENAI_CATEGORY_THRESHOLD="75" # skip category AI when score is above this
# OPENAI_MAX_TOKENS="1200"       # cap response length per call
# OPENAI_RETRY="false"           # retry failed calls (doubles cost on failures)

# Google PageSpeed Insights API key — STRONGLY RECOMMENDED.
# Free key from: https://developers.google.com/speed/docs/insights/v5/get-started
# Also powers: Chrome UX Report (CrUX) and Google Safe Browsing.
# Enable "Chrome UX Report API" and "Safe Browsing API" in the same Google Cloud project.
# PAGESPEED_DESKTOP="true"   # optional — desktop Lighthouse adds ~1–2 min per audit (mobile runs by default)
PAGESPEED_API_KEY=""

# Links category — free domain authority / inbound link strength (Open PageRank).
# Sign up: https://www.domcop.com/openpagerank/
OPENPAGERANK_API_KEY=""

# Public site URL — used for canonical URLs, sitemap, Open Graph, and JSON-LD.
# Set to your production domain in deployment (e.g. https://tryseoaudit.com).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay — optional "Buy us a coffee" support payments.
# Create keys at https://dashboard.razorpay.com/app/keys
# Webhook URL: https://your-domain.com/api/support/coffee/webhook
# Enable events: payment.authorized, payment.captured, payment.failed, refund.processed
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# Admin dashboard — run `npm run db:seed-admin` after setting these.
AUTH_SECRET="generate-a-random-string-at-least-32-characters-long"
ADMIN_EMAIL="admin@flexodynsolutions.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Vercel deployment
# - Audits use Next.js after() to finish in the background (see src/lib/audit/schedule-audit.ts).
# - Full audits need up to 300s — use Vercel Pro (Hobby caps at 60s and may time out on large sites).
# - Use MongoDB Atlas for DATABASE_URL; run db:push and db:seed-admin once after deploy.
